rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼ 두 사람의 로그인 이메일 (소문자로)
    function husband() { return '남편이메일@example.com'; }
    function wife()    { return '아내이메일@example.com'; }

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function member()   { return signedIn() && request.auth.token.email.lower() in [husband(), wife()]; }
    function owner()    { return signedIn() && request.auth.token.email.lower() == husband(); }

    // 가계부 데이터: 두 사람만 읽고 쓸 수 있음
    match /households/main/{col}/{docId} {
      allow read: if member();
      allow write: if member() && !(col == 'config' && (docId == 'lock' || docId == 'owner'));
    }
    // 잠금번호와 소유자 정보: 남편 계정만 바꿀 수 있음
    match /households/main/config/{docId} {
      allow write: if owner() && (docId == 'lock' || docId == 'owner');
    }
    // 그 밖의 모든 경로는 막힘
  }
}
